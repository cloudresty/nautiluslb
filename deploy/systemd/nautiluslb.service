# NautilusLB systemd unit for running outside Kubernetes (a VM or bare-metal
# pair in front of a cluster). Install and usage: deploy/systemd/README.md.
#
#   Binary      /usr/local/bin/nautiluslb
#   Config      /etc/nautiluslb/config.yaml          (root:root 0644)
#   Kubeconfig  /etc/nautiluslb/kubeconfig           (root:nautiluslb 0640)
#               referenced by settings.kubernetes.kubeconfig in config.yaml
#
# The service runs as an ephemeral DynamicUser. It reads the kubeconfig through
# the static `nautiluslb` group (SupplementaryGroups), so the credential is never
# world-readable and no login account exists.

[Unit]
Description=NautilusLB Layer 4 load balancer for Kubernetes
Documentation=https://github.com/cloudresty/nautiluslb
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStartPre=/usr/local/bin/nautiluslb --validate --config /etc/nautiluslb/config.yaml
ExecStart=/usr/local/bin/nautiluslb --config /etc/nautiluslb/config.yaml
# SIGHUP reloads the configuration in place; a configuration that fails
# validation is rejected and the running one is kept. Validate first with
# `nautiluslb --validate --config /etc/nautiluslb/config.yaml`.
ExecReload=/bin/kill -HUP $MAINPID

# SIGTERM drains: /readyz turns 503, drain.readinessDelay (3s) passes, then open
# connections get up to drain.timeout (30s), force-closed ones up to 5s more,
# and the access log and admin server up to 2s each (worst case ~42s). Keep
# TimeoutStopSec >= drain.timeout + readinessDelay + 15s, or systemd SIGKILLs
# a drain in progress.
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=60
Restart=on-failure
RestartSec=2

# Identity: ephemeral user. ConfigurationDirectory creates /etc/nautiluslb if
# missing and keeps it root-owned (0755), unlike State/Logs directories.
DynamicUser=yes
SupplementaryGroups=nautiluslb
ConfigurationDirectory=nautiluslb
# Writable only if settings.accessLog.output points at /var/log/nautiluslb/...
LogsDirectory=nautiluslb

# One file descriptor per client connection plus one per backend connection.
LimitNOFILE=1048576

# Bind ports below 1024 and nothing more.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Hardening
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native
# @system-service includes splice, tee, vmsplice, pipe2 and (via @network-io)
# getsockopt/setsockopt, which the splice path needs (checked on systemd 257).
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
